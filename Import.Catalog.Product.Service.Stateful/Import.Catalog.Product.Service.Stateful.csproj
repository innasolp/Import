<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Import catalog product stateful service</Title>
    <PackageOutputPath>$(SolutionDir)\packages</PackageOutputPath>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>innasolp</Authors>
    <RepositoryUrl>https://github.com/innasolp/Import</RepositoryUrl>
  </PropertyGroup>
 <ItemGroup>
    <ProjectReference Include="..\Import.Catalog.Product.Service\Import.Catalog.Product.Service.csproj" />
    <ProjectReference Include="..\Import.KeyHash\Import.KeyHash.csproj" />
    <ProjectReference Include="..\Import.ServiceState\Import.ServiceState.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ImportProductStatefulLogMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ImportProductStatefulLogMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ImportProductStatefulLogMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ImportProductStatefulLogMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
