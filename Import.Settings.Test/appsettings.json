{
    "OzonCategories": {
        "Name": "Ozon",
        "Caption": "Ozon",
        "Url": "https://www.ozon.ru",
        "CategorySourceUrl": "https://www.ozon.ru",
        "Services": {
            "ImportService": {
                "ImplementationTypeName": "ShopImportCategoriesSimpleService",
                "AssemblyPath": "Import\\Categories\\Services",
                "ServiceProviderPath": "Import\\Categories\\Json"
            },
            "Loader": {
                "ImplementationTypeName": "TestLoaderService2",
                "AssemblyPath": "Libs\\webLoader\\Playwright\\ChromiumPatchright"
            },
            "CategoryItemHandler": {
                "ImplementationTypeName": "TestCategoryItemHandler2",
                "AssemblyPath": "Libs\\webLoader\\Playwright\\ChromiumPatchright"
            },
            "HostRequestOptions": {
                "Value": {
                    "RouteUrlFormat": "https://www.ozon.ru/api/entrypoint-api.bx/page/json/v2?url=%2FsearchSuggestions",
                    "LoadingType": "Response",
                    "TimeouteMillseconds": 15000
                }
            },
            "RequestOptions": {
                "Value": {
                    "LoadingType": "Api"
                }
            },
            "TimerOptions": {
                "Value": {
                    "SecondsInterval": 10800
                }
            },
            "JobExecuteOptions": {
                "Value": {
                    "IntervalInSeconds": 86400
                }
            },
            "LoadStages": [
                {
                    "Type": "TreeItemJsonFromHtmlLoader",
                    "Options": {
                        "HtmlSearchFactoryOptions": {
                            "SearchMatchType": 1,
                            "SearchElementType": 0
                        },
                        "HtmlSearchOptions": {
                            "Tag": "div",
                            "SearchString": "id=state-catalogMenu",
                            "ValueString": "data-state"
                        },
                        "FirstNodePath": [
                            "data",
                            "columns",
                            "categories"
                        ],
                        "PropertyPaths": {
                            "Url": {
                                "PropertyName": "Url",
                                "Path": "url"
                            },
                            "Description": {
                                "PropertyName": "Description",
                                "Path": "title"
                            },
                            "Name": {
                                "PropertyName": "Name",
                                "Path": "title"
                            },
                            "Children": {
                                "PropertyName": "Children",
                                "Path": "categories"
                            }
                        }
                    }
                },
                {
                    "Type": "JsonTreeItemLoader",
                    "Options": {
                        "UrlFormat": "https://www.ozon.ru/api/composer-api.bx/_action/v2/categoryChildV3?menuId=185&categoryId={0}",
                        "FirstNodePath": [
                            "data",
                            "columns",
                            "categories"
                        ],
                        "PropertyPaths": {
                            "Url": {
                                "PropertyName": "Url",
                                "Path": "url"
                            },
                            "Description": {
                                "PropertyName": "Description",
                                "Path": "title"
                            },
                            "Name": {
                                "PropertyName": "Name",
                                "Path": "title"
                            },
                            "Children": {
                                "PropertyName": "Children",
                                "Path": "categories"
                            }
                        }
                    }
                }
            ]
        }
    }
}