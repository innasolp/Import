<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.0.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Import service state in-memory provider</Title>
    <PackageOutputPath>$(SolutionDir)\packages</PackageOutputPath>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>innasolp</Authors>
    <RepositoryUrl>https://github.com/innasolp/Import</RepositoryUrl>
  </PropertyGroup>
<ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Import.ServiceState\Import.ServiceState.csproj" />
  </ItemGroup>
</Project>
