<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Import.Catalog.Category.Interfaces\Import.Catalog.Category.Interfaces.csproj" />
    <ProjectReference Include="..\Import.TreeItem\Import.TreeItem.csproj" />
    <ProjectReference Include="..\Import.Service\Import.Service.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Import catalog category service</Title>
    <PackageOutputPath>$(SolutionDir)\packages</PackageOutputPath>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>innasolp</Authors>
    <RepositoryUrl>https://github.com/innasolp/Import</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="ImportCategoryLogMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ImportCategoryLogMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="ImportCategoryLogMessages.resx" VisualStudioMode="true">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ImportCategoryLogMessages.Designer.cs</LastGenOutput>
      <LogicalName>Import.Catalog.Category.Service.ImportCategoryLogMessages.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>